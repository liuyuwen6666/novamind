# ============================================================
# NovaMind 项目根 .env.example
# 使用方法: cp .env.example .env  然后填入真实值
# ============================================================

# ── 数据库配置 ─────────────────────────────────────────────
# PostgreSQL 用户名
POSTGRES_USER=postgres
# PostgreSQL 密码（生产环境请修改！）
POSTGRES_PASSWORD=novamind123
# 数据库名称
POSTGRES_DB=novamind
# 数据库端口（宿主机映射端口）
POSTGRES_PORT=5432

# ── 服务端口 ──────────────────────────────────────────────
# 后端 API 端口
BACKEND_PORT=8000
# 前端端口（访问 http://服务器IP:3000）
FRONTEND_PORT=3000

# ── 前端 API 地址配置 ─────────────────────────────────────
# ⚠️  重要: 部署到服务器时，改为你的服务器公网IP
# 例如: http://123.45.67.89:8000
# 本地开发: http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000

# ── App ───────────────────────────────────────────────────
APP_NAME=NovaMind API
APP_VERSION=0.1.0
DEBUG=false

# ── CORS 允许的来源 ────────────────────────────────────────
# 格式: JSON 数组字符串
# 本地: ["http://localhost:3000","http://localhost:5173"]
# 服务器: ["http://123.45.67.89:3000"]
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── LLM 配置（大语言模型）────────────────────────────────
LLM_API_KEY=你的LLM_API_KEY
LLM_BASE_URL=https://api.longcat.ai/v1
LLM_MODEL=longcat

# ── Embedding 配置（向量化模型）──────────────────────────
EMBEDDING_API_KEY=你的EMBEDDING_API_KEY
EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
EMBEDDING_MODEL=doubao-embedding
EMBEDDING_DIMENSION=1024

# ── RAG 配置 ──────────────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=100
RAG_TOP_K=5

# ── 其他工具 ──────────────────────────────────────────────
WEATHER_API_KEY=你的_weather_api_key
MAX_MEMORY_MESSAGES=20
