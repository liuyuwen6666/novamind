# NovaMind Backend 环境变量
# 保存路径：/opt/novamind/backend/.env

# ── App ──────────────────────────────────────────────
APP_NAME=NovaMind API
APP_VERSION=0.1.0
DEBUG=false

# ── Database ─────────────────────────────────────────
# Docker Compose 部署时，数据库主机使用 postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/novamind

# ── LLM (LongCat) ───────────────────────────────────
LLM_API_KEY=
LLM_BASE_URL=https://api.longcat.ai/v1
LLM_MODEL=longcat

# ── Embedding (字节/火山) ────────────────────────────
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
EMBEDDING_MODEL=doubao-embedding
EMBEDDING_DIMENSION=1024

# ── RAG ──────────────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=100
RAG_TOP_K=5

# ── Tool: Weather ────────────────────────────────────
WEATHER_API_KEY=你的_weather_api_key

# ── Memory ───────────────────────────────────────────
MAX_MEMORY_MESSAGES=20

# ── CORS ─────────────────────────────────────────────
# 允许 Cloudflare 前端域名访问后端
ALLOWED_ORIGINS=["https://dadishu.asia","https://www.dadishu.asia"]