# NovaMind Backend 环境变量
# 复制此文件为 .env 并填写实际值

# ── App ──────────────────────────────────────────────
APP_NAME=NovaMind API
DEBUG=false

# ── Database ─────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/novamind

# ── LLM (LongCat) ───────────────────────────────────
LLM_API_KEY=your_longcat_api_key
LLM_BASE_URL=https://api.longcat.ai/v1
LLM_MODEL=longcat

# ── Embedding (字节/火山) ────────────────────────────
EMBEDDING_API_KEY=your_volc_api_key
EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
EMBEDDING_MODEL=doubao-embedding
EMBEDDING_DIMENSION=1024

# ── RAG ──────────────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=100
RAG_TOP_K=5

# ── Tool: Weather ────────────────────────────────────
WEATHER_API_KEY=your_weather_api_key

# ── CORS ─────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]
